# Base URL of the backend API (no trailing slash).
# Local:      http://localhost:8080
# Production: https://<your-render-service>.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# Shared secret required by the manual-scrape endpoint.
# NOTE: anything with a VITE_ prefix is bundled into the JavaScript and is
# therefore PUBLIC. Only set this for a local/demo deployment. Leave it empty in
# production and trigger scrapes from cron-job.org or the CLI instead.
VITE_SCRAPE_SECRET=
