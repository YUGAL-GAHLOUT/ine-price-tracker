# Base URL of the backend API (no trailing slash).
# Local:      http://localhost:8080
# Production: https://<your-render-service>.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# Low-privilege token that enables the dashboard's "Scrape now" button.
# Anything with a VITE_ prefix is bundled into the JavaScript and is therefore
# PUBLIC — which is exactly why this is a SEPARATE token from CRON_SECRET.
# It can only re-scrape an already-tracked product, and the backend rate limits
# it to 6 requests per 10 minutes per IP.
# Must match MANUAL_SCRAPE_TOKEN on the backend. Leave empty to hide the button.
# NEVER put CRON_SECRET here.
VITE_MANUAL_SCRAPE_TOKEN=
