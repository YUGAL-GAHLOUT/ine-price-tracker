# ---------------------------------------------------------------
# Backend environment. Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------

# Supabase — Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE ROLE key (secret, bypasses RLS). Backend only — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret protecting POST /api/cron/scrape. Server-side only — never ships
# to the browser. Generate with:  openssl rand -hex 32
CRON_SECRET=replace-me-with-a-long-random-string

# Optional, and MUST be a different value from CRON_SECRET. Enables the
# dashboard's "Scrape now" button: it may re-scrape one already-tracked product
# and nothing else, and is rate limited to 6 requests per 10 min per IP. This
# value IS bundled into the public frontend build (as VITE_MANUAL_SCRAPE_TOKEN),
# which is why it is separate from the cron secret. Leave unset to disable the
# button. Generate with:  openssl rand -hex 24
MANUAL_SCRAPE_TOKEN=

# HTTP
PORT=8080
NODE_ENV=development
# Comma-separated list of allowed browser origins, or * for any.
CORS_ORIGINS=http://localhost:5173

# Logging: debug | info | warn | error
LOG_LEVEL=info

# --- Scraper tuning (all optional; defaults shown) ---------------
# Attempts per product per run, including the first.
SCRAPE_MAX_ATTEMPTS=4
# Hard ceiling for one attempt (the store sometimes never responds at all).
SCRAPE_ATTEMPT_TIMEOUT_MS=60000
# Exponential backoff with full jitter between attempts.
SCRAPE_RETRY_BASE_MS=1500
SCRAPE_RETRY_MAX_MS=15000
# Products scraped in parallel. Each one is a browser tab — keep this small.
SCRAPE_CONCURRENCY=2
# A run still marked "running" after this long is treated as dead and released.
SCRAPE_RUN_LOCK_STALE_MS=1200000
