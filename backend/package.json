{
  "name": "ine-price-tracker-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.x" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "scrape:once": "node scripts/scrape-cli.js",
    "scrape:headed": "node scripts/scrape-cli.js --headed --slow --all",
    "scrape:demo": "node scripts/scrape-cli.js --headed --slow --id 312 --repeat 5",
    "catalog:sync": "node scripts/sync-catalog.js",
    "test": "node --test tests/*.test.js",
    "postinstall": "playwright install --with-deps chromium chromium-headless-shell || playwright install chromium chromium-headless-shell"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "playwright": "1.49.1",
    "zod": "^3.23.8"
  }
}
